<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/ScreenRoot">
        <TextView
            style="@style/AiTaskCaption"
            android:text="AI: check_visual_order  ·  meaningful-visual-order"/>
        <TextView
            style="@style/AiRuleCaption"
            android:text="Also expected: reading order + missing/incorrect heading (whole-tree + text rules)"/>


        <!-- Form: visual order is scrambled - Submit appears first, then Email, then Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign up"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="10dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:background="@color/brand_primary"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="you@example.com"
                android:padding="10dp"
                android:background="@drawable/card_bg"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your name"
                android:padding="10dp"
                android:background="@drawable/card_bg"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 3 of 3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:paddingTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1 of 3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 2 of 3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Checkout form: Pay button comes before card details, expiry/CVV reversed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checkout"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="10dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pay ₹4,999"
                android:background="@color/brand_primary"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card number"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1234 5678 9012 3456"
                android:padding="10dp"
                android:background="@drawable/card_bg"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CVV"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="123"
                android:padding="10dp"
                android:background="@drawable/card_bg"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MM/YY"
                android:padding="10dp"
                android:background="@drawable/card_bg"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Wizard with Finish button before steps, and step labels in reverse order -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up your workspace"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="10dp"/>

            <!-- Rendered as a non-clickable TextView on purpose. A real Button/EditText is a
     candidate for interactable- / editable-element-content-label and the input-field
     rules, which would make this screen report check_accessibility_label and
     check_input_field_purpose issues on top of its own AI task. It still carries text
     and is focusable, so it keeps its place in the traversal order this screen tests. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Finish setup"
                android:background="@color/brand_primary"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Invite teammates"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Choose a plan"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Pick an avatar"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Create workspace name"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>
        </LinearLayout>

        <!-- Itemized receipt where total appears above the items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order receipt"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total: ₹2,400"
                android:textColor="@color/violation_red"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item 3 — Phone case (₹400)"
                android:textColor="@color/text_primary"
                android:paddingTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item 1 — USB-C cable (₹600)"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item 2 — Charger brick (₹1,400)"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
