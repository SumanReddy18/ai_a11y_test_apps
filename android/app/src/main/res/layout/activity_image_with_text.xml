<?xml version="1.0" encoding="utf-8"?>
<!-- importantForAccessibility="no" on every tile is deliberate, and it is what keeps
         this screen on ONE AI task. imageview-element-content-label bails on
         `if (!view.isAccessible) return` (BSAIRules.kt), so hiding the tiles from the
         a11y tree removes them from check_image_label — the imageviewLabel screen's job.
         images-of-text has no such guard: it keys only on the role plus OCR text, so this
         screen still raises check_images_of_text exactly as before.

         It is also a real violation shape: an image carrying meaning in its pixels that a
         developer has marked decorative. -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">
        <TextView
            style="@style/AiTaskCaption"
            android:text="AI: check_images_of_text  ·  images-of-text"/>
        <TextView
            style="@style/AiRuleCaption"
            android:text="Also expected on every screen: reading/visual order + missing/incorrect heading"/>


    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:columnCount="2"
        android:rowCount="5"
        android:useDefaultMargins="false">

        <!-- 1: no contentDescription -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_01"
                android:importantForAccessibility="no"/>

        <!-- 2: generic "image" -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_02"
            android:contentDescription="image"
                android:importantForAccessibility="no"/>

        <!-- 3: description ignores embedded text -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_03"
            android:contentDescription="A diagram"
                android:importantForAccessibility="no"/>

        <!-- 4: empty contentDescription -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_04"
            android:contentDescription=""
                android:importantForAccessibility="no"/>

        <!-- 5: generic "photo" -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_05"
            android:contentDescription="photo"
                android:importantForAccessibility="no"/>

        <!-- 6: filename used as label -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_06"
            android:contentDescription="img_06.jpg"
                android:importantForAccessibility="no"/>

        <!-- 7: marketing label hides text -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_07"
            android:contentDescription="Welcome banner"
                android:importantForAccessibility="no"/>

        <!-- 8: single word "graphic" -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_08"
            android:contentDescription="graphic"
                android:importantForAccessibility="no"/>

        <!-- 9: generic "icon" -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_09"
            android:contentDescription="icon"
                android:importantForAccessibility="no"/>

        <!-- 10: generic "picture" -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/unsplash_text_10"
            android:contentDescription="picture"
                android:importantForAccessibility="no"/>

    </GridLayout>

</LinearLayout>
