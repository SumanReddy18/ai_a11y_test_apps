<?xml version="1.0" encoding="utf-8"?>
<!-- Two-screen fixture, screen 2: order & input rules.
     Violations, top to bottom (input rules first so they sit in the first viewport —
     the type sub-rule was historically missed below the fold):
       1. Input field labels — caption TextView with NO labelFor above a bare EditText
          (no hint, no desc): the field has no programmatic name.
       2. Input type — a PROPERLY labelled field (caption + labelFor + hint) whose
          android:inputType and android:autofillHints contradict the label.
       3. Link text purpose — links whose whole accessible name is a stop-word phrase
          ("Click here", "Read more") or a raw URL; spanned end-to-end in the Activity.
       4. Images with text — a second text-bearing image (wordmark), mirroring screen 1
          so the rule gets two chances across the pair. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/ScreenRoot">

        <!-- 1 + 2. Input field labels & input type. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg">

            <!-- Caption with NO labelFor; EditText with no hint/desc -> unnamed field. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/text_primary"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>

            <!-- Labelled correctly (caption + labelFor + hint), but the TYPE lies:
                 an email field declared as phone, autofill agreeing with the lie. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email address"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"
                android:labelFor="@+id/tsEmailTyped"/>
            <EditText
                android:id="@+id/tsEmailTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="phone"
                android:autofillHints="phone"/>
        </LinearLayout>

        <!-- 3. Link text purpose: each phrase is its own TextView, whole-text-spanned in
             SmallAppSecondActivity, so the phrase IS the accessible name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Our refund policy changed on 1 August."
                android:textColor="@color/text_primary"/>
            <TextView
                android:id="@+id/tsLinkClickHere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Click here"
                android:textColor="@color/info_blue"
                android:paddingTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The 2026 shipping calendar is out."
                android:textColor="@color/text_primary"
                android:paddingTop="10dp"/>
            <TextView
                android:id="@+id/tsLinkReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read more"
                android:textColor="@color/info_blue"
                android:paddingTop="4dp"/>

            <TextView
                android:id="@+id/tsLinkRawUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://help.example.com/articles/8842-returns"
                android:textColor="@color/info_blue"
                android:paddingTop="10dp"/>
        </LinearLayout>

        <!-- 4. Images with text (second chance, mirrors screen 1): a bold wordmark whose
             words exist only as pixels; labelled, so only images-with-text fires here. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/text_image_quote"
            android:contentDescription="Feature artwork"/>

    </LinearLayout>
</ScrollView>
