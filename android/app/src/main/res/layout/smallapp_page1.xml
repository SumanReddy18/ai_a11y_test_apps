<?xml version="1.0" encoding="utf-8"?>
<!-- Two-screen fixture, screen 1: visual & label rules.
     Violations, top to bottom (each shaped to what the ai-accessibility judge prompts
     actually flag — see the per-section comments):
       1. Images with text  — flat promo banner ("50% off"), words exist only as pixels.
       2. ImageView label   — the same banner carries NO contentDescription.
       3. Interactive label — icon ImageButton with no desc + two unlabeled clickable
          icon containers (flat-colour crops are filtered out as "Blank").
       4. Missing heading   — section titles 20sp bold over two 13sp body lines each,
          no accessibilityHeading (incorrect-heading lives on screen 2 to respect the
          judge's 1-4 headings-per-screen budget).
       5. Meaningful reading order — numbered steps announced 3, 1, 4, 2 with the section
          title announced last (shuffled ordered list + heading-after-content).
       6. Meaningful visual order — Sign up card with the CTA ABOVE its input fields
          (the judge's one named violation shape).
     Both pages live in ONE activity (see activity_smallapp.xml for why). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ScreenRoot">

        <!-- 1+2. One image, two violations: a flat PROMO banner — the only image class
             the images-with-text judge does not exempt (wordmarks -> Logo, typographic
             art / document scans -> Essential; promo copy like "50% off" is its named
             Informative example). Words are pixels only, and NO contentDescription at
             all (imageview label). -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/banner_offer50"/>

        <!-- 3. Interactive label: unlabeled icon button (also feeds the image-label rule)
             plus two unlabeled clickable Views — the pattern PROVEN to fire the
             interactive-element rule (an empty-text Button never did; an ImageButton
             routes to the imageview rule instead). Mirrors InteractiveLabelActivity's
             ctaPrimary/ctaDanger. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/card_bg"/>

            <!-- Clickable containers with icon CONTENT but no speakable text: the AI
                 judge's image filter drops flat-colour crops as "Blank" before scoring,
                 so an unlabeled button must LOOK like a button. Icons are marked
                 not-important so the parents stay genuinely unlabeled. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="#C2410C"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_heart"
                    android:importantForAccessibility="no"
                    android:tint="#FFFFFF"/>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@color/violation_red"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trash"
                    android:importantForAccessibility="no"
                    android:tint="#FFFFFF"/>
            </FrameLayout>
        </LinearLayout>

        <!-- 4. Missing heading: 20sp bold titles over 13sp secondary body, NO
             android:accessibilityHeading anywhere (the proven visual gap). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 items in your cart, arriving Friday between 9am and 1pm."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:paddingTop="2dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signature required on delivery. Contactless drop-off is available from settings."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:paddingTop="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visa ending 4242, billed to your home address."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:paddingTop="2dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your next charge is on the 1st of every month unless you cancel earlier."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:paddingTop="2dp"/>
        </LinearLayout>

        <!-- (Incorrect heading moved to screen 2: the missing-heading judge keeps a
             1-4 headings-per-screen budget, and the two wrongly-marked elements were
             crowding out the real candidates here.) -->

        <!-- 6. Meaningful reading order: an ORDERED LIST announced out of sequence plus a
             heading announced after its content — the two shapes the MRO judge's prompt
             names as violations and does NOT whitelist. (A "Buy button first" card is
             explicitly a valid pattern to that judge and always came back Not an Issue.)
             Visual: title, Step 1, 2, 3, 4. TalkBack: Step 3 -> 1 -> 4 -> 2 -> title. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:id="@+id/saRoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to return an item"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="17sp"
                android:accessibilityTraversalAfter="@+id/saRoStep2"/>

            <TextView
                android:id="@+id/saRoStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="1. Open your orders"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:accessibilityTraversalAfter="@+id/saRoStep3"/>

            <TextView
                android:id="@+id/saRoStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="2. Select the item and reason"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:accessibilityTraversalAfter="@+id/saRoStep4"/>

            <TextView
                android:id="@+id/saRoStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="3. Print the return label"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/saRoStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="4. Drop the parcel at any partner store"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:accessibilityTraversalAfter="@+id/saRoStep1"/>
        </LinearLayout>

        <!-- 7. Meaningful visual order: the ONE shape the visual-order judge names as a
             violation — "CTA appearing before necessary input/relevant information".
             Submit sits ABOVE the fields it submits. (Fields are hint-labelled with
             correct input types so no input rule fires here by accident.) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign up"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Create account"
                android:backgroundTint="@color/brand_primary"
                android:textColor="#FFFFFF"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Full name"
                android:inputType="textPersonName"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"/>
        </LinearLayout>

    </LinearLayout>
