<?xml version="1.0" encoding="utf-8"?>
<!-- Two-screen fixture, screen 1: visual & label rules.
     Violations, top to bottom:
       1. Images with text  — one text-bearing banner whose words exist only as pixels;
          no TextView repeats the words.
       2. ImageView label   — the same banner carries NO contentDescription.
       3. Interactive label — icon ImageButton with no desc + two unlabeled clickable Views.
       4. Missing heading   — section titles 20sp bold over 13sp body, no accessibilityHeading.
       5. Incorrect heading — 14sp body text wrongly flagged accessibilityHeading="true".
       6. Meaningful reading order — product card whose traversal reads the Buy button
          first (buy -> title -> desc -> price), the dedicated screen's proven shape.
       7. Meaningful visual order — checkout steps stacked 3, 1, 2 on screen.
     No manual navigation: the activity auto-advances to screen 2 after one full
     auto-scroll pass (see SmallAppFirstActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/ScreenRoot">

        <!-- 1+2. One image, two violations: the banner's words are pixels, not text
             elements (images with text), and it carries NO contentDescription at all
             (imageview label). -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/text_image_ocr"/>

        <!-- 3. Interactive label: unlabeled icon button (also feeds the image-label rule)
             plus two unlabeled clickable Views — the pattern PROVEN to fire the
             interactive-element rule (an empty-text Button never did; an ImageButton
             routes to the imageview rule instead). Mirrors InteractiveLabelActivity's
             ctaPrimary/ctaDanger. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageButton
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/card_bg"/>

            <View
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@color/brand_primary"
                android:clickable="true"
                android:focusable="true"/>

            <View
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@color/violation_red"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 4. Missing heading: 20sp bold titles over 13sp secondary body, NO
             android:accessibilityHeading anywhere (the proven visual gap). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 items in your cart, arriving Friday between 9am and 1pm."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingTop="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="14dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visa ending 4242, billed to your home address."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingTop="2dp"/>
        </LinearLayout>

        <!-- 5. Incorrect heading: plain body copy and a vague one-worder, both wrongly
             carrying accessibilityHeading="true". -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery partners may call you from a masked number before arriving."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:accessibilityHeading="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:accessibilityHeading="true"/>
        </LinearLayout>

        <!-- 6. Meaningful reading order: the proven product-card shape from the dedicated
             screen — TalkBack reads Buy now -> title -> description -> price while the
             screen reads title -> price -> description -> Buy now. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:id="@+id/saProdTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Wireless Headphones X9"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:accessibilityTraversalAfter="@+id/saProdBuy"/>

            <TextView
                android:id="@+id/saProdPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="₹4,999  (was ₹7,999)"
                android:textColor="@color/violation_red"
                android:textStyle="bold"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/saProdTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:accessibilityTraversalAfter="@+id/saProdDesc"/>

            <TextView
                android:id="@+id/saProdDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Active noise cancelling with 32-hour battery life and adaptive EQ tuned for podcasts and music."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/saProdPrice"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:accessibilityTraversalAfter="@+id/saProdTitle"/>

            <Button
                android:id="@+id/saProdBuy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Buy now"
                android:backgroundTint="@color/brand_primary"
                android:textColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/saProdDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 7. Meaningful visual order: inherently ordered steps stacked 3, 1, 2. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Confirm order"
                android:textColor="@color/text_primary"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Add to cart"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Enter address"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
