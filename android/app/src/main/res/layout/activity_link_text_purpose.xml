<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/ScreenRoot">

        <!-- Each link is its OWN TextView whose entire text is the vague phrase, spanned
             end-to-end in LinkTextPurposeActivity.

             This matters: link-text-purpose judges the element's speakable text, not the
             span's substring. When a ClickableSpan covered "click here" inside "To view our
             refund policy, click here", the detected label was the whole sentence — which
             does convey a purpose — so only the raw-URL line was ever reported. With the
             phrase alone as the element text, "click here" / "read more" / "here" /
             "learn more" / "tap here" / "this" / "more" are exact matches for the rule's
             stop-word list and fail deterministically, without needing AI review. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To view our refund policy,"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/linkClickHere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="click here"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New pricing is now live."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read more"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full release notes are available"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkHere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="here"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Three identical "Learn more" links pointing at different pages. To a screen-reader
             user navigating link-by-link they are indistinguishable. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Automate tests on real devices."
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/linkLearnMore1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn more"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Catch accessibility issues early."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkLearnMore2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn more"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scale your CI pipeline."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkLearnMore3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn more"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Machine text as the link label: a raw URL, a filename, and "#". None of these are
             stop words, so they go to AI review with the phrase alone as the detected label. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Documentation:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/linkRawUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://www.browserstack.com/docs/app-accessibility/overview?ref=demo&amp;src=apk"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signed agreement:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkFilename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="policy_v2_final.pdf"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skip to the pricing table:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkHash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- More ambiguous phrases, all exact stop-word matches. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To update your billing details,"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/linkTapHere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tap here"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For onboarding steps, see"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkThis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="this"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Integrations are expanding every week."
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="14dp"/>

            <TextView
                android:id="@+id/linkMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColorLink="@color/brand_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
