<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- focusableInTouchMode + beforeDescendants keeps the first EditText from grabbing
         focus on launch, so the soft keyboard never covers the screen during a scan. -->
    <LinearLayout style="@style/ScreenRoot"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">

        <!-- Meaningful reading order.

             The violation IS the layout order — there are no android:accessibilityTraversal*
             overrides here on purpose. A signup form has one logical sequence: name, then
             password, then confirm it, then submit. This screen lays that out upside down, so
             focus (which follows layout order, top to bottom) hits "Signup now" first and
             "Enter name" last. A screen-reader user is asked to submit before being given
             anything to fill in.

             That is what the judge reports: "the focus order follows an illogical bottom-to-top
             sequence instead of a logical top-to-bottom reading path".

             Every element here is INTERACTIVE (two Buttons, three EditTexts). The rule
             evaluates the focus order of interactive elements, so a screen made of TextViews
             with traversal overrides is a weaker test than this one.

             Expect this screen to report the editable-element / input-label rules too — the
             inputs are named only by their hints. That is accepted noise; keeping them
             placeholder-only is what makes the form read the way the image shows. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg">

            <!-- 1st in focus order, last in logic: submit, before anything has been entered. -->
            <Button
                android:id="@+id/roSignup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signup now"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_primary"/>

            <!-- Confirm a password that has not been asked for yet. -->
            <EditText
                android:id="@+id/roConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Confirm password"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/roLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Login now"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="@color/brand_primary"/>

            <EditText
                android:id="@+id/roPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Enter password"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <!-- Last in focus order, first in logic. -->
            <EditText
                android:id="@+id/roName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Enter name"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPersonName"
                android:importantForAutofill="no"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
