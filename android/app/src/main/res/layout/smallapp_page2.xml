<?xml version="1.0" encoding="utf-8"?>
<!-- Two-screen fixture, screen 2: order & input rules.
     Violations, top to bottom (input rules first so they sit in the first viewport —
     the type sub-rule was historically missed below the fold):
       1. Input field labels — a completely BARE EditText (no caption, no hint): a
          visible caption would satisfy the judge's visible-text precedence rule.
       2. Input type — a PROPERLY labelled field (caption + labelFor + hint) whose
          android:inputType and android:autofillHints contradict the label.
       3. Link text purpose — bare links whose whole accessible name is a stop-word
          phrase ("Click here", "Read more") or a raw URL, with no context sentences
          nearby; spanned end-to-end in the Activity.
       4. Incorrect heading — body prose + vague "Info", both accessibilityHeading=true.
       5. Images with text — a second flat promo banner, mirroring screen 1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ScreenRoot">

        <!-- 1 + 2. Input field labels & input type. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg">

            <!-- Completely bare field: no caption, no hint, no desc. A visible "Email"
                 caption above it would SATISFY the input-label judge ("persistent
                 visible text holds precedence"), so there must be nothing nearby that
                 explains the field. Boxed background so the crop filter can't call the
                 element "Blank". -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/card_bg"/>

            <!-- Labelled correctly, but the TYPE lies. The judge receives the RAW
                 inputType int and has been seen mis-decoding ambiguous values in the
                 label's favour (it read 3/phone as "email"), so both mismatches below
                 use famously-decodable constants:
                 129 = textPassword on an EMAIL field (renders dots over an email hint),
                 1   = plain text on a PASSWORD field (typed password stays visible). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email address"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"
                android:labelFor="@+id/tsEmailTyped"/>
            <EditText
                android:id="@+id/tsEmailTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="textPassword"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/text_primary"
                android:paddingTop="14dp"
                android:labelFor="@+id/tsPasswordPlain"/>
            <EditText
                android:id="@+id/tsPasswordPlain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter password"
                android:inputType="text"/>
        </LinearLayout>

        <!-- 3. Link text purpose: each phrase is its own TextView, whole-text-spanned in
             SmallAppActivity, so the phrase IS the accessible name. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <!-- Bare links with NO surrounding sentences: the link judge's 80-90 band
                 lets nearby context rescue a stop-word phrase, so nothing on screen
                 may explain where these go. -->
            <TextView
                android:id="@+id/tsLinkClickHere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Click here"
                android:textColor="#0B57D0"/>

            <TextView
                android:id="@+id/tsLinkReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read more"
                android:textColor="#0B57D0"
                android:paddingTop="10dp"/>

            <TextView
                android:id="@+id/tsLinkRawUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://help.example.com/articles/8842-returns"
                android:textColor="#0B57D0"
                android:paddingTop="10dp"/>
        </LinearLayout>

        <!-- 4. Incorrect heading (moved from screen 1 for the heading budget): plain
             body copy and a vague one-worder, both wrongly accessibilityHeading="true". -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery partners may call you from a masked number before arriving."
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:accessibilityHeading="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:accessibilityHeading="true"/>
        </LinearLayout>

        <!-- 5. Images with text (second chance, mirrors screen 1): another flat promo
             banner (the only image class the judge does not exempt); labelled, so only
             images-with-text fires here. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/banner_freedelivery"
            android:contentDescription="Feature artwork"/>

    </LinearLayout>
