<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- focusableInTouchMode + beforeDescendants keeps the first EditText from grabbing
         focus on launch, so the soft keyboard never covers the screen during a scan. -->
    <LinearLayout style="@style/ScreenRoot"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">

        <TextView style="@style/ScreenH1" android:text="@string/rule9_title"/>
        <TextView style="@style/ScreenSub" android:text="@string/rule9_desc"/>

        <!-- ============================================================
             Sub-rule A — "Accessible input field labels"
             ============================================================ -->

        <TextView style="@style/SectionLabel" android:background="@drawable/badge_red"
            android:text="VIOLATION 1: sign-up form — captions not linked to inputs"/>

        <!-- Each caption below is a plain TextView with NO android:labelFor, and each
             EditText has no android:hint and no contentDescription. Sighted users see a
             caption; TalkBack announces a bare "Edit box". The captions also imply a
             specific data type ("Phone number", "Date of birth") while every field is
             android:inputType="text" — so the input-type sub-rule fires here too. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Surname"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflSurname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <!-- Caption says "Phone number", inputType says free text. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Phone number"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:background="@drawable/badge_red"
            android:text="VIOLATION 2: no label at all — bare inputs"
            android:layout_marginTop="18dp"/>

        <!-- Verification-code boxes and an address row with no caption, no hint and no
             contentDescription: nothing at all identifies these fields. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the 3-digit code we sent you"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/iflCode1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>

                <EditText
                    android:id="@+id/iflCode2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>

                <EditText
                    android:id="@+id/iflCode3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>
            </LinearLayout>

            <!-- Two address lines, completely unlabelled. -->
            <EditText
                android:id="@+id/iflAddress1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflAddress2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:background="@drawable/badge_red"
            android:text="VIOLATION 3: placeholder used instead of a label"
            android:layout_marginTop="18dp"/>

        <!-- Hint-only fields. The hint is the ONLY thing naming the field, and it
             disappears as soon as the user types — the label is not persistent. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <EditText
                android:id="@+id/iflEmailHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflCityHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="City"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflDobHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="DD / MM / YYYY"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- ============================================================
             Sub-rule B — "Input type for input fields"
             ============================================================ -->

        <TextView style="@style/SectionLabel" android:background="@drawable/badge_red"
            android:text="VIOLATION 4: inputType contradicts the label"
            android:layout_marginTop="18dp"/>

        <!-- These fields ARE labelled properly (visible caption + android:labelFor +
             hint), so the label sub-rule passes. What fails is the TYPE: each
             android:inputType is wrong for the data the label asks for, so the user
             gets the wrong keyboard and no useful autofill. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <!-- Email field typed as a phone number. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/iflEmailTyped"
                android:text="Email address"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflEmailTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="you@example.com"
                android:textColorHint="@color/text_secondary"
                android:inputType="phone"
                android:importantForAutofill="no"/>

            <!-- Phone field typed as an email address. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflMobileTyped"
                android:text="Mobile number"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflMobileTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="+91 98765 43210"
                android:textColorHint="@color/text_secondary"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"/>

            <!-- Numeric amount typed as a person's name. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflAmountTyped"
                android:text="Amount (USD)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflAmountTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="0.00"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPersonName"
                android:importantForAutofill="no"/>

            <!-- Website URL typed as a decimal number. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflUrlTyped"
                android:text="Website URL"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflUrlTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://example.com"
                android:textColorHint="@color/text_secondary"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:background="@drawable/badge_red"
            android:text="VIOLATION 5: sensitive fields without a secure input type"
            android:layout_marginTop="18dp"/>

        <!-- Password / CVV entered as plain visible text: no textPassword, no
             numberPassword — the characters are not masked and the field is not
             announced as a password field. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/iflPassword"
                android:text="Password"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter your password"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflConfirmPassword"
                android:text="Confirm password"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Re-enter your password"
                android:textColorHint="@color/text_secondary"
                android:inputType="textVisiblePassword"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflCvv"
                android:text="Card CVV"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflCvv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="3 digits on the back of your card"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="Two sub-rules on one screen. Accessible input field labels — violations 1–3: visible captions that are not linked with android:labelFor, fields with no label of any kind, and fields whose only name is a placeholder hint that vanishes on typing. Input type for input fields — violations 4–5: android:inputType contradicts the label (email typed as phone, phone typed as email, amount as person name, URL as decimal) and password / CVV fields with no secure input type. WCAG 1.3.5 / 2.4.6 / 3.3.2."/>
    </LinearLayout>
</ScrollView>
