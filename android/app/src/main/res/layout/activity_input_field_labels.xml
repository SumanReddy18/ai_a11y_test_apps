<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- focusableInTouchMode + beforeDescendants keeps the first EditText from grabbing
         focus on launch, so the soft keyboard never covers the screen during a scan. -->
    <LinearLayout style="@style/ScreenRoot"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">
        <TextView
            style="@style/AiTaskCaption"
            android:text="AI: check_input_field_purpose"/>
        <TextView
            style="@style/AiRuleCaption"
            android:text="accessible-input-field-label + input-type-for-input-field · also raises check_accessibility_label (any editable)"/>


        <!-- ============================================================
             Sub-rule A — "Accessible input field labels"
             ============================================================ -->

        <!-- Each caption below is a plain TextView with NO android:labelFor, and each
             EditText has no android:hint and no contentDescription. Sighted users see a
             caption; TalkBack announces a bare "Edit box". The captions also imply a
             specific data type ("Phone number", "Date of birth") while every field is
             android:inputType="text" — so the input-type sub-rule fires here too. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Surname"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflSurname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <!-- Caption says "Phone number", inputType says free text. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Phone number"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/iflPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- Verification-code boxes and an address row with no caption, no hint and no
             contentDescription: nothing at all identifies these fields. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the 3-digit code we sent you"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/iflCode1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>

                <EditText
                    android:id="@+id/iflCode2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>

                <EditText
                    android:id="@+id/iflCode3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="text"
                    android:importantForAutofill="no"/>
            </LinearLayout>

            <!-- Two address lines, completely unlabelled. -->
            <EditText
                android:id="@+id/iflAddress1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflAddress2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- Hint-only fields. The hint is the ONLY thing naming the field, and it
             disappears as soon as the user types — the label is not persistent. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <EditText
                android:id="@+id/iflEmailHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflCityHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="City"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/iflDobHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="DD / MM / YYYY"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- ============================================================
             Sub-rule B — "Input type for input fields"
             ============================================================ -->

        <!-- These fields ARE labelled properly (visible caption + android:labelFor +
             hint), so the label sub-rule passes. What fails is the TYPE: each
             android:inputType is wrong for the data the label asks for, so the user
             gets the wrong keyboard and no useful autofill.

             android:autofillHints deliberately contradicts the label as well, and these
             fields do NOT carry importantForAutofill="no" the way the rest of the screen
             does. The rule inspects "declared type, keyboard type, and autofill metadata";
             opting a field out of autofill removed the metadata it wants to compare, so
             there was nothing left to disagree with. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <!-- Email field typed as a phone number. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/iflEmailTyped"
                android:text="Email address"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflEmailTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="you@example.com"
                android:textColorHint="@color/text_secondary"
                android:inputType="phone"
                android:autofillHints="phone"/>

            <!-- Phone field typed as an email address. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflMobileTyped"
                android:text="Mobile number"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflMobileTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="+91 98765 43210"
                android:textColorHint="@color/text_secondary"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"/>

            <!-- Numeric amount typed as a phone number.
                 NOTE: this used to be android:inputType="textPersonName", which reads
                 better as a bug but is undetectable — TYPE_TEXT_VARIATION_PERSON_NAME maps
                 to category "Text Input", and the rule short-circuits every Text Input to
                 PASS ("Text Input fields are always valid") before any regex runs. Phone is
                 an equally real mistake that the rule can actually catch. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflAmountTyped"
                android:text="Amount (USD)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflAmountTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="0.00"
                android:textColorHint="@color/text_secondary"
                android:inputType="phone"
                android:autofillHints="phone"/>

            <!-- Website URL typed as a decimal number. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflUrlTyped"
                android:text="Website URL"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflUrlTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://example.com"
                android:textColorHint="@color/text_secondary"
                android:inputType="numberDecimal"
                android:autofillHints="postalCode"/>
        </LinearLayout>

        <!-- Password / CVV entered as plain visible text: no textPassword, no
             numberPassword — the characters are not masked and the field is not
             announced as a password field. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/iflPassword"
                android:text="Password"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter your password"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:autofillHints="password"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflConfirmPassword"
                android:text="Confirm password"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Re-enter your password"
                android:textColorHint="@color/text_secondary"
                android:inputType="textEmailAddress"
                android:autofillHints="password"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflCvv"
                android:text="Card CVV"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflCvv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="3 digits on the back of your card"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:autofillHints="creditCardSecurityCode"/>
        </LinearLayout>


        <!-- ============================================================
             Categories the screen never reached.

             The four groups above only ever produce two verdicts: "Element has no
             text" (11x, the fields with no labelFor) and three type mismatches. Three
             of the rule's six categories were never exercised at all, and the
             PASS-by-regex-match branch — a correctly typed field — had no fixture, so
             the rule could have been inverted and this screen would not have noticed.
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg">

            <!-- Password Input, correctly typed. The ONLY PASS-by-regex-match on this
                 screen: category "Password Input", label "Password" matches its regex. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/iflPasswordCorrect"
                android:text="Password"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflPasswordCorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter your password"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:autofillHints="password"/>

            <!-- Password Input on an email-labelled field: masks what the user types into
                 a field that is not a secret. Category matches nothing in the label. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflEmailAsPassword"
                android:text="Email address"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflEmailAsPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="you@example.com"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:autofillHints="emailAddress"/>

            <!-- Date &amp; Time Input on a name-labelled field. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflNameAsDate"
                android:text="Full name"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflNameAsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="DD / MM / YYYY"
                android:textColorHint="@color/text_secondary"
                android:inputType="date"
                android:autofillHints="birthDateFull"/>

            <!-- Postal Address Input. TYPE_TO_CATEGORY maps this type, but CATEGORY_REGEX
                 has NO entry for it — so the rule returns NOT_APPLICABLE. That branch had
                 no fixture, which means nothing would have noticed if it started failing. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/iflAddressTyped"
                android:text="Delivery address"
                android:textColor="@color/text_primary"
                android:textSize="13sp"/>

            <EditText
                android:id="@id/iflAddressTyped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Flat, street, city"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPostalAddress"
                android:autofillHints="postalAddress"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
